# LINK-ing web service (copy to .env for local use)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_BACKEND_ONLY_KEY
DEMO_USERNAME=demo
DEMO_PASSWORD=replace-with-a-long-random-value
ADMIN_PASSWORD=replace-with-a-different-long-random-value

# Needed for Slack collection and AI extraction
SLACK_TOKEN=xoxb_REPLACE_ME
OPENAI_API_KEY=sk_REPLACE_ME

# Separate ML API; must be HTTPS or a Railway private-network URL
MODEL_API_URL=https://YOUR_ML_SERVICE.up.railway.app
MODEL_API_KEY=replace-with-the-same-value-as-ml-service

# Set to 1 only after verifying the slack_messages schema
SLACK_MESSAGES_SCHEMA_VERIFIED=0
